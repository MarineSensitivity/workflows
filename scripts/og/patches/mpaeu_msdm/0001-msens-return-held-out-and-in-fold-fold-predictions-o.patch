@@ -1,3 +1,38 @@
+
+# msens patch: held-out fold predictions ----
+# each CV fold returns its metrics AND the held-out (test) and in-fold (train) predictions
+# (idx = row index in the fit table, so methods align). Switch off: options(obissdm.cvpred = FALSE).
+.cvpred_on <- function() isTRUE(getOption("obissdm.cvpred", TRUE))
+
+.cvpred_df <- function(fold, idx, presence, pred) {
+  data.frame(fold = as.integer(fold), idx = as.integer(idx),
+             presence = as.integer(presence), pred = as.numeric(pred))
+}
+
+# bind the per-fold list(metrics, test, train) into the metrics matrix + cvpred attributes
+.cv_bind <- function(blocks_results) {
+  res <- do.call("rbind", lapply(blocks_results, function(x) x[["metrics"]]))
+  if (.cvpred_on()) {
+    attr(res, "cvpred") <- do.call("rbind", lapply(blocks_results, function(x) x[["test"]]))
+    attr(res, "cvpredtrain") <- do.call("rbind", lapply(blocks_results, function(x) x[["train"]]))
+  }
+  res
+}
+
+# the cvpred attributes must not leak into cvmetrics (arrow would embed them in the parquet metadata)
+.cv_strip <- function(x) { attr(x, "cvpred") <- NULL; attr(x, "cvpredtrain") <- NULL; x }
+
+# keep the cvpred of the best tune so far (strict > mirrors which.max()[1])
+.cv_keep <- function(best, k_score, tune_block) {
+  if (!.cvpred_on()) return(best)
+  if (!is.na(k_score) && (is.null(best$score) || k_score > best$score)) {
+    best <- list(score = unname(k_score),
+                 test = attr(tune_block, "cvpred"),
+                 train = attr(tune_block, "cvpredtrain"))
+  }
+  best
+}
+
