From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ben Best <ben@ecoquants.com>
Date: Tue, 6 Oct 2026 15:21:54 +0200
Subject: [PATCH 2/2] msens: plot.sdm_respcur works with current dplyr (tapply
 list-array)

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01H6zetzjywCQX7iXJC33wMu
---
 R/sdm_addons.R | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/R/sdm_addons.R b/R/sdm_addons.R
index ce08bdb..4e2844b 100644
--- a/R/sdm_addons.R
+++ b/R/sdm_addons.R
@@ -284,7 +284,8 @@ plot.sdm_respcur <- function(response_curves) {
     # Prepare additional data
     fake <- data.frame(x = c(0, 0), y = c(0, 0), rg = factor(c(0, 1), levels = c(0,1)))
     rc_temp <- response_curves[response_curves$in_range == 1,]
-    ab_dat <- tapply(rc_temp$base, rc_temp$variable, function(x) data.frame(min = range(x)[1], max = range(x)[2]))
+    # msens patch: split()+lapply() instead of tapply() (tapply returns a 1-d list array that current dplyr::bind_rows rejects)
+    ab_dat <- lapply(split(rc_temp$base, rc_temp$variable), function(x) data.frame(min = range(x)[1], max = range(x)[2]))
     n_ab_dat <- names(ab_dat)
     ab_dat <- dplyr::bind_rows(ab_dat, .id = "variable")
     ab_dat$variable <- n_ab_dat
