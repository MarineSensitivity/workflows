   for (i in seq_len(length(algorithms))) {
     if (verb_1) cli::cli_alert_info("Fitting {algorithms[i]}")
+    mark(paste("Fit", algorithms[i]), "start")
     model_fits[[i]] <- try(do.call(paste0("sdm_module_", algorithms[i]),
                                     list(sp_data, verbose = verb_2,
                                         options = algo_opts[[i]])))
     if (inherits(model_fits[[i]], "try-error")) {
       model_log$model_result[[algorithms[i]]] <- "failed"
+      mark(paste("Fit", algorithms[i]), "failed")
       model_fits[[i]] <- FALSE
     } else {
       model_log$model_result[[algorithms[i]]] <- "succeeded"
+      mark(paste("Fit", algorithms[i]), "done")
     }
   }
 
@@ -1565,3 +1568,21 @@ split_ds <- function(sp_occ,
   if (dir.exists(d_sp) && length(list.files(d_sp, all.files = TRUE, no.. = TRUE)) == 0) fs::dir_delete(d_sp)
   invisible(NULL)
 }
+
+# msens patch: progress marks ----
+# returns mark(what, note = ""), which appends one row (time, what, note) to
+# {outfolder}/taxonid={species}/model={outacro}/taxonid={species}_model={outacro}_what=progress.tsv.
+# never stops a fit: every write is wrapped in try().
+.og_marker <- function(outfolder, species, outacro) {
+  dir <- file.path(outfolder, paste0("taxonid=", species), paste0("model=", outacro))
+  f <- file.path(dir, paste0("taxonid=", species, "_model=", outacro, "_what=progress.tsv"))
+  try({
+    dir.create(dir, recursive = TRUE, showWarnings = FALSE)
+    cat("time\twhat\tnote\n", file = f)
+  }, silent = TRUE)
+  function(what, note = "") {
+    try(cat(sprintf("%s\t%s\t%s\n", format(Sys.time(), "%Y-%m-%d %H:%M:%S"), what, note), file = f, append = TRUE),
+        silent = TRUE)
+    invisible(NULL)
+  }
+}
