Subject: [PATCH 4/4] msens: clean only taxonid=<id>/model=<acro>, never other
 acronyms' runs

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01H6zetzjywCQX7iXJC33wMu
---
 functions/components_model_species.R | 11 +++++++++++
 functions/model_species.R            | 13 ++++---------
 2 files changed, 15 insertions(+), 9 deletions(-)

diff --git a/functions/components_model_species.R b/functions/components_model_species.R
index 8d58116..8c94233 100644
--- a/functions/components_model_species.R
+++ b/functions/components_model_species.R
@@ -1554,3 +1554,14 @@ split_ds <- function(sp_occ,
   }
   list(hab_depth = hab_depth, note = note)
 }
+
+
+# msens patch: delete {outfolder}/taxonid={species}/model={outacro} only, then the taxonid folder if it is empty,
+# so runs with different acronyms can share an output root.
+.cm_clean_species <- function(outfolder, species, outacro) {
+  d_sp <- file.path(outfolder, paste0("taxonid=", species))
+  d_mod <- file.path(d_sp, paste0("model=", outacro))
+  if (dir.exists(d_mod)) fs::dir_delete(d_mod)
+  if (dir.exists(d_sp) && length(list.files(d_sp, all.files = TRUE, no.. = TRUE)) == 0) fs::dir_delete(d_sp)
+  invisible(NULL)
+}
diff --git a/functions/model_species.R b/functions/model_species.R
index a315fe2..b45be5a 100644
--- a/functions/model_species.R
+++ b/functions/model_species.R
@@ -106,9 +106,8 @@ model_species <- function(species,
   
   if (verb_1) cli::cli_alert_info("Starting model for species {species}")
 
-  if (cleanup && dir.exists(file.path(outfolder, paste0("taxonid=", species)))) {
-    fs::dir_delete(file.path(outfolder, paste0("taxonid=", species)))
-  }
+  # msens patch: clean only THIS acronym's folder (OBIS deleted taxonid=<id>/ and with it every other model= run)
+  if (cleanup) .cm_clean_species(outfolder, species, outacro)
   
   # Record timing
   treg <- obissdm::.get_time()
@@ -486,17 +485,13 @@ model_species <- function(species,
       } else {
         if (verb_1) cli::cli_alert_warning("No good model available")
         st_status <- "no_good_model"
-        if (dir.exists(file.path(outfolder, paste0("taxonid=", species)))) {
-          fs::dir_delete(file.path(outfolder, paste0("taxonid=", species)))
-        }
+        .cm_clean_species(outfolder, species, outacro)
       }
       
     } else {
       if (verb_1) cli::cli_alert_warning("All models failed")
       st_status <- "all_failed"
-      if (dir.exists(file.path(outfolder, paste0("taxonid=", species)))) {
-          fs::dir_delete(file.path(outfolder, paste0("taxonid=", species)))
-      }
+      .cm_clean_species(outfolder, species, outacro)
     }
     
   } else {
