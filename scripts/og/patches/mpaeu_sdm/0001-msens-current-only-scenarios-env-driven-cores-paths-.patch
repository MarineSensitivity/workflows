+
+
+# msens patch: held-out fold predictions + run manifest ----
+# cvpred: held-out (test-fold) predictions of the SELECTED tune of each fitted algorithm;
+# cvpredtrain: the same fold-models' predictions on their own training rows.
+# columns: species, method, fold, idx (row in the fit table, aligns methods), presence, lon, lat, pred (0-1)
+.cm_save_cvpred <- function(model_fits, metric_out, species, outacro, good_models, sp_data) {
+  coords <- sp_data$coord_training
+  fs::dir_create(metric_out)
+  for (id in good_models) {
+    fit <- model_fits[[id]]
+    for (what in c("cvpred", "cvpredtrain")) {
+      d <- fit[[what]]
+      if (is.null(d)) next
+      d$species <- species
+      d$method <- fit$name
+      d$lon <- coords[[1]][d$idx]
+      d$lat <- coords[[2]][d$idx]
+      d <- d[, c("species", "method", "fold", "idx", "presence", "lon", "lat", "pred")]
+      arrow::write_parquet(d, paste0(metric_out, "taxonid=", species, "_model=", outacro,
+                                     "_method=", fit$name, "_what=", what, ".parquet"))
+    }
+  }
+  invisible(NULL)
+}
+
+.cm_git_info <- function(repo) {
+  g <- function(...) tryCatch(
+    trimws(system2("git", c("-C", shQuote(repo), ...), stdout = TRUE, stderr = FALSE)[1]),
+    error = function(e) NA_character_, warning = function(w) NA_character_)
+  list(repo = repo, sha = g("rev-parse", "HEAD"), branch = g("rev-parse", "--abbrev-ref", "HEAD"),
+       dirty = length(tryCatch(system2("git", c("-C", shQuote(repo), "status", "--porcelain"),
+                                       stdout = TRUE, stderr = FALSE), error = function(e) "?")) > 0)
+}
+
+.cm_write_manifest <- function(species, outfolder, outacro, group, hab_depth, env, multi_mod,
+                               sp_data, model_log, algorithms, t_start, seed) {
+  lyr <- terra::subset(env$layers, multi_mod$best_variables)
+  inst <- file.path(Sys.getenv("OG_DATA", file.path(path.expand("~"), "_big/sdm/mpaeu")), "obissdm_install.json")
+  si <- sessionInfo()
+  pk <- c(si$otherPkgs, si$loadedOnly)
+  manifest <- list(
+    species = species, model_acro = outacro, group = group, seed = seed,
+    start = format(t_start, "%Y-%m-%d %H:%M:%S %Z"), end = format(Sys.time(), "%Y-%m-%d %H:%M:%S %Z"),
+    host = Sys.info()[["nodename"]], n_cores = as.integer(Sys.getenv("OG_CORES", "NA")),
+    r_version = R.version.string,
+    git = list(mpaeu_sdm = .cm_git_info(getwd()),
+               mpaeu_msdm = .cm_git_info(Sys.getenv("OG_MSDM_REPO", file.path(path.expand("~"), "Github/iobis/mpaeu_msdm"))),
+               obissdm_install = if (file.exists(inst)) jsonlite::read_json(inst) else NA),
+    hab_depth = hab_depth,
+    layers = list(names = names(lyr), files = terra::sources(lyr),
+                  hypothesis = multi_mod$best_model),
+    background = list(type = "uniform random cells of the masked env stack (realms of occurrence + adjacent, depth range +/- buffer); mp_prepare_data(), sample() without replacement",
+                      size = unlist(model_log$model_details$background_size),
+                      n_presence = sum(sp_data$training$presence),
+                      n_background = sum(sp_data$training$presence == 0)),
+    algorithms = algorithms,
+    options = list(scenarios = if (identical(Sys.getenv("OG_SCENARIOS"), "all")) "all" else "current",
+                   cvpred = isTRUE(getOption("obissdm.cvpred", TRUE))),
+    packages = lapply(pk, function(x) x$Version)
+  )
+  outf <- paste0(outfolder, "/taxonid=", species, "/model=", outacro, "/taxonid=", species,
+                 "_model=", outacro, "_what=manifest.json")
+  jsonlite::write_json(manifest, outf, auto_unbox = TRUE, pretty = TRUE, null = "null", na = "null")
+  invisible(outf)
+}
