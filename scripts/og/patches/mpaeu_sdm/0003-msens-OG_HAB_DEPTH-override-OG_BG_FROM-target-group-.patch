+
+
+# msens patch: target-group background ----
+# OG_BG_FROM = a parquet (cell_id, lon, lat) of target-group record locations, optionally with an {id} placeholder
+# (replaced by the AphiaID), or a .csv map (taxonid,file) for a different file per species. Unset = random background.
+.cm_bg_file <- function(species) {
+  f <- Sys.getenv("OG_BG_FROM")
+  if (!nzchar(f)) return(NULL)
+  f <- path.expand(f)
+  if (grepl("\\.csv$", f)) {
+    m <- utils::read.csv(f, stringsAsFactors = FALSE)
+    hit <- m$file[m$taxonid == as.numeric(species)]
+    stopifnot("OG_BG_FROM map has no single row for this species" = length(hit) == 1)
+    f <- path.expand(hit)
+  } else {
+    f <- gsub("{id}", species, f, fixed = TRUE)
+  }
+  stopifnot("target-group file not found" = file.exists(f))
+  f
+}
+
+# target-group locations that sit on non-NA cells of `env_layers` (the species' masked stack), shaped exactly like the
+# training table mp_prepare_data builds (so it can be passed as pred_quad)
+.cm_bg_pool <- function(file, env_layers) {
+  d <- as.data.frame(arrow::read_parquet(file, col_select = c("lon", "lat")))
+  v <- terra::extract(env_layers, d[, c("lon", "lat")], ID = FALSE)
+  ok <- stats::complete.cases(v)
+  out <- cbind(decimalLongitude = d$lon[ok], decimalLatitude = d$lat[ok], presence = 0, v[ok, , drop = FALSE])
+  rownames(out) <- NULL
+  out
+}
+
+
+# msens patch: seeding that does not depend on how the species is run ----
+# furrr(seed = TRUE) switches the worker's RNG kind to L'Ecuyer-CMRG, and set.seed(x) keeps the CURRENT kind, so the same
+# seed gives a different stream in a batch than in a single-species (Mersenne-Twister) run. Pin the kind explicitly.
+.cm_seed <- function(x) {
+  set.seed(as.integer(x), kind = "Mersenne-Twister", normal.kind = "Inversion", sample.kind = "Rejection")
+}
+
+
+# msens patch: OG_HAB_DEPTH (depthsurf | depthmean | depthmax) overrides the habitat-derived layer depth for loading,
+# prediction, post-evaluation and (through log.json hab_depth) bootstrap. Unset = OBIS behaviour (hab_to_depth()).
+.cm_hab_depth <- function(hab) {
+  hab_depth <- hab_to_depth(hab)
+  ov <- Sys.getenv("OG_HAB_DEPTH")
+  note <- NULL
+  if (nzchar(ov)) {
+    stopifnot("OG_HAB_DEPTH must be depthsurf, depthmean or depthmax" = ov %in% c("depthsurf", "depthmean", "depthmax"))
+    note <- paste0("hab_depth overridden by OG_HAB_DEPTH: ", hab_depth, " (mode_life ", hab, ") -> ", ov)
+    hab_depth <- ov
+  }
+  list(hab_depth = hab_depth, note = note)
+}
