.vscode

# NOT ignored: data/manifests/*.json are the content-addressed CHECKPOINTS each
# target writes (target, content_hash, and the counts that stage produced) --
# closer to a lockfile than to build state. They were ignored as "regenerated by
# tar_make; not source", and the cost of that showed up as a registry regression
# that left NO reviewable trace: publish_native.json recorded
# `n_pmtiles_native: 0` and nobody could see it in a diff. 120 KB for 30 files,
# and a bad run now shows up as a changed hash and a changed count.
#
# The real build state stays ignored:
_targets/

# Python bytecode from the final-report build scripts
__pycache__/

# per-user Claude Code settings (permissions etc.), not project config
.claude/settings.local.json

# knitr intermediates Quarto leaves beside a .qmd; the .qmd is authoritative and
# these go stale silently (explore_regions.rmarkdown trailed its .qmd by a year)
*.rmarkdown
